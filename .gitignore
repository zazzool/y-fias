# Артефакты сборки
/bin/
/dist/
*.exe

# Данные: качаются ингестом, в репозиторий не кладутся
/data/
/testdata/gar/
/testdata/osm/
*.yfsnap

# Golden-корпус выгружается с прода скриптом, содержит адреса —
# в публичный репозиторий не попадает. Только манифест с контрольными суммами.
/testdata/golden/*.csv

# Локальное окружение
.env
.env.local

# Инструменты
/.tools/
coverage.out
*.test
*.prof
